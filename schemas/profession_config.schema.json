{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/profession_config.schema.json",
  "title": "Profession graph run configuration",
  "type": "object",
  "required": ["profession", "grades", "source", "dictionaries"],
  "properties": {
    "profession": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "aliases": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "grades": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["junior", "middle", "senior"]}
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["file", "hh", "hh_public_pages", "trudvsem", "hh_requests"]},
        "base_url": {"type": "string", "format": "uri"},
        "path": {"type": "string"},
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://(www\\.)?hh\\.ru/vacancy/[0-9]+/?$"}
        },
        "contact_email": {"type": "string", "format": "email"},
        "contact_email_env": {"type": "string"},
        "request_interval_seconds": {"type": "number", "minimum": 0, "maximum": 30},
        "queries": {"type": "array", "items": {"type": "string"}},
        "areas": {"type": "array", "items": {"type": "string"}},
        "region_codes": {"type": "array", "items": {"type": "string"}},
        "period_days": {"type": "integer", "minimum": 1},
        "date_chunk_days": {"type": "integer", "minimum": 1, "maximum": 30},
        "per_page": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_vacancies": {"type": "integer", "minimum": 0},
        "relevance_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "min_title_match_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "user_agent": {"type": "string"},
        "user_agent_env": {"type": "string"},
        "token_env": {"type": "string"},
        "include_inactive": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "dictionaries": {
      "type": "object",
      "required": ["nodes"],
      "properties": {"nodes": {"type": "string"}},
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["phrases", "splits"],
      "properties": {
        "phrases": {"type": "string"},
        "splits": {"type": "string"}
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "min_children": {"type": "integer", "minimum": 1},
        "min_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "target_depth": {"type": "integer", "minimum": 2, "maximum": 6},
        "max_depth": {"type": "integer", "minimum": 2, "maximum": 6},
        "target_leaf_min": {"type": "integer", "minimum": 1},
        "target_leaf_max": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "grade_rules": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["signals", "experience", "salary", "experience_then_salary", "salary_then_experience", "combined"]},
        "conflict_policy": {"enum": ["keep_best", "exclude"]},
        "junior_max_years": {"type": "integer", "minimum": 0},
        "middle_max_years": {"type": "integer", "minimum": 1},
        "salary_currency": {"type": "string", "minLength": 3},
        "junior_max_salary": {"type": "number", "exclusiveMinimum": 0},
        "middle_max_salary": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "scoring": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["prevalence", "weighted_legacy"]}
      },
      "additionalProperties": true
    },
    "learning": {
      "type": "object",
      "properties": {
        "catalog": {"type": "string"},
        "max_per_node": {"type": "integer", "minimum": 1},
        "check_links": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "template_version": {"type": "string"},
        "known_icons": {"type": "object"}
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "base_url": {"type": ["string", "null"]},
        "api_key_env": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 180}
      },
      "additionalProperties": false
    },
    "analysis": {"type": "object"}
  },
  "additionalProperties": false
}
